# ==============================================================================
# MARIEE.VN - SUPABASE CONFIGURATION
# ==============================================================================

# 1. Supabase Project ID (ví dụ: cdjxfvnyuqrbpicjsrnz)
# Lấy tại: Supabase Dashboard -> Project Settings -> General -> Reference ID
SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"

# 2. Supabase URL (ví dụ: https://xxxx.supabase.co)
# Lấy tại: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# 3. Supabase Anon / Publishable Key (Public Key cho Client)
# Lấy tại: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon / public
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"

# 4. Supabase Service Role Key (Bí mật - Dùng cho Server / Admin bypass RLS)
# Lấy tại: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
# LƯU Ý: Tuyệt đối không để lộ key này ra phía client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# 5. Lovable API Key (Tùy chọn - chỉ dùng nếu bạn vẫn muốn kết nối dịch vụ Email Webhook của Lovable)
# LOVABLE_API_KEY=""

# 6. Telegram Bot (Quản trị từ xa & Thông báo)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# 7. Google Sheets & Google Drive RSVP Sync
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/xxxx/exec"
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"
